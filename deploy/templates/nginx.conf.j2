events {
    worker_connections 1024;
}

http {
    upstream audit_backend {
        server audit-svc:8080;
    }

    server {
        listen 8088;

        location ~* ^/+reload {
            return 404;
        }

        location / {
            proxy_pass http://audit_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }

    server {
        listen 8089;
        location /stub_status {
            stub_status;
            allow all;
        }
    }
}
